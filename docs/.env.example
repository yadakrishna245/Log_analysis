# LogSherlock Pro - Environment Configuration
# Copy this file to .env and update values

# Application Environment (development | testing | production)
FLASK_ENV=development

# Secret key - MUST change in production
SECRET_KEY=change-this-to-a-random-string-in-production

# Database (leave empty for SQLite default, set for PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/logsherlock

# Server
HOST=127.0.0.1
PORT=5000

# Upload settings
MAX_UPLOAD_SIZE_MB=500

# Analysis
ANALYSIS_TIMEOUT_SECONDS=300
PATTERN_MATCH_THRESHOLD=0.75

# Logging
LOG_LEVEL=INFO

# Redis (optional, for Celery background tasks)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
